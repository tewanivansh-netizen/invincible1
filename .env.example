# Application Port (Render automatically sets PORT)
PORT=3000
NODE_ENV=production

# Session Security
SESSION_SECRET=your_random_secure_session_secret_here

# Cloud MySQL Database Configuration
DB_HOST=your-cloud-db-host.com
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=invincible
DB_PORT=3306

# Set to true for cloud providers requiring SSL (e.g. TiDB Cloud, Aiven), false for local MySQL
DB_SSL=true

# Optional: Full MySQL Connection URL (if provided by host)
# DATABASE_URL=mysql://user:password@host:port/database
